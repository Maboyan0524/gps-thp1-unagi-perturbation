# Copy to .env and edit, then `set -a; . ./.env; set +a` before running.

# ---- stage 1, GPS retrained on THP-1 ----
WORK_DIR=/path/to/lincs_workdir
GPSRCL_DIR=/path/to/this/repo/gps_thp1
GPS_CODE=/path/to/GPS4Drugs/code
CONDA_BIN=/path/to/conda/bin
GPS_SELECTED_GENES=/path/to/GPS4Drugs/data/input_gene_features/selected_genes_2198.csv
FINETUNED_MODELS=/path/to/gps_finetune_models
PERGENE_OUT=/path/to/output/pergene_rho.csv

# ---- stage 2, UNAGI perturbation ----
UNAGI_SRC=/path/to/UNAGI
UNAGI_IDREM=/path/to/UNAGI/idrem
UNAGI_DRUG=/path/to/UNAGI/drug
SIL_H5AD=/path/to/macro_branch1_silicosis.h5ad
SIL_MACRO_QS=/path/to/macro_cells.qs
SIL_PLOTDATA=/path/to/plotdata.csv
ITCM_DIR=/path/to/itcm_differential_expression
GPS_CONTINUOUS=/path/to/gps_continuous_profiles
THP1_DRUG_GENES=/path/to/thp1_drug_genes.pkl
MODEL_DATA=/path/to/unagi_model_data
TRAJ_TEST_OUT=/path/to/trajectory_quality_test
